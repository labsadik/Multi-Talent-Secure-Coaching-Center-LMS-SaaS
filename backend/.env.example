# Copy this file to backend/.env for local development.
# Never commit backend/.env or real credentials.

APP_ENV=development
HOST=127.0.0.1
PORT=8080
RUST_LOG=info,newage_api=debug,tower_http=info

# MongoDB. Atlas SRV URIs are supported.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=newage
MONGODB_MAX_POOL_SIZE=50

# Generate a unique random secret (at least 32 bytes). Do not reuse across environments.
JWT_SECRET=local-development-only-change-this-secret-to-a-random-value
JWT_ISSUER=https://api.newage.local
JWT_AUDIENCE=newage-web
JWT_TTL_SECONDS=900

# Comma-separated exact browser origins. Wildcard origins are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=26214400
MAX_ASSET_UPLOAD_BYTES=20971520
HTTP_CLIENT_TIMEOUT_SECONDS=15

# Generate a 32-byte key and base64-encode it. Required in production.
# Example command: openssl rand -base64 32
APP_ENCRYPTION_KEY_BASE64=

# Bunny Storage (optional until media endpoints are enabled).
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=

# Bunny Stream shared library (optional until video endpoints are enabled).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TUS_ENDPOINT=https://video.bunnycdn.com/tusupload
BUNNY_UPLOAD_SIGNATURE_TTL_SECONDS=21600
# Enable Embed View Token Authentication in Bunny Stream security settings, then set this key.
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_PLAYBACK_TOKEN_TTL_SECONDS=3600

# Slack Sign in with Slack (optional). The redirect URI must exactly match the one
# registered in the Slack app AND frontend/.env NUXT_SLACK_REDIRECT_URI.
# Map each company slug to its Slack workspace team ID without adding DB fields.
# Example: SLACK_COMPANY_WORKSPACES_JSON={"acme-learning":"T0123456789"}
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_COMPANY_WORKSPACES_JSON=

# Platform Razorpay credentials (optional until platform billing routes are enabled).
# Tenant-specific Razorpay credentials must be encrypted before database storage.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Platform billing webhook secret (different from each tenant's own webhook secret).
RAZORPAY_WEBHOOK_SECRET=

# SaaS monthly plan prices, stored in integer paise.
PLAN_STARTER_MONTHLY_PRICE_PAISE=99900
PLAN_PRO_MONTHLY_PRICE_PAISE=199900
PLAN_BUSINESS_MONTHLY_PRICE_PAISE=499900

# Per-company caps (active courses and active learners).
PLAN_FREE_MAX_COURSES=1
PLAN_FREE_MAX_LEARNERS=50
PLAN_STARTER_MAX_COURSES=10
PLAN_STARTER_MAX_LEARNERS=500
PLAN_PRO_MAX_COURSES=50
PLAN_PRO_MAX_LEARNERS=5000
PLAN_BUSINESS_MAX_COURSES=500
PLAN_BUSINESS_MAX_LEARNERS=50000
